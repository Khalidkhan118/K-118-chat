rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper function to check if the authenticated user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // USERS COLLECTION (/users/{userId})
    // - Authenticated users can read user profiles (for searching users by name,
    //   email, or Firebase Auth UID, viewing contacts, and resolving chat partners).
    // - Authenticated users can write/update their profile, online presence,
    //   contacts list, and status privacy settings.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // CHATS COLLECTION (/chats/{chatId})
    // - Allow authenticated users to read/write chats collection.
    // - Handles 1-on-1 chats between 2 devices using Firebase Auth UIDs.
    // - Supports collection queries such as:
    //     collection("chats").whereArrayContains("participants", myUid)
    // =========================================================================
    match /chats/{chatId} {
      // Allow authenticated users to read and list chats
      allow read: if isAuthenticated();

      // Allow authenticated users to create and update chat metadata
      // (participants array, lastMessage, lastMessageTimestamp, unread counts)
      allow write: if isAuthenticated();

      // -----------------------------------------------------------------------
      // MESSAGES SUBCOLLECTION (/chats/{chatId}/messages/{messageId})
      // Allows authenticated devices to send, listen, react, delete, and update
      // read receipts (isRead, readBy, deliveredTo) in real-time.
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // -----------------------------------------------------------------------
      // TYPING INDICATOR SUBCOLLECTION (/chats/{chatId}/typing/{userId})
      // Allows devices to broadcast and listen to real-time typing indicators.
      // -----------------------------------------------------------------------
      match /typing/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // =========================================================================
    // STATUSES (STORIES) COLLECTION (/statuses/{statusId})
    // 24-hour disappearing status updates with viewers, captions, and privacy.
    // =========================================================================
    match /statuses/{statusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // CALLS COLLECTION (/calls/{callId})
    // Audio / video call logs and signaling between devices.
    // =========================================================================
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
